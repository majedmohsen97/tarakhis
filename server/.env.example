# Copy to .env and adjust. All values are optional in development.

PORT=4000
# REQUIRED in production: a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_TTL=7d

# Public URL printed inside gate-pass QR codes, e.g. https://api.tarakhis.sa
PUBLIC_URL=
# Comma-separated origins allowed to call the API in production (the web dashboard)
CORS_ORIGINS=

# Optional: Ed25519 private key (PKCS#8 PEM, \n-escaped) for signing gate passes.
# If empty, a key is generated once and stored in data/pass-keys.json.
PASS_PRIVATE_KEY=

DATA_DIR=data
APP_TZ=Asia/Riyadh
PASS_TTL_MIN=15
EXPIRING_SOON_DAYS=30
VAT_RATE=0.15
CURRENCY=SAR
MAX_UPLOAD_MB=10
